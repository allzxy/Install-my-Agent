{
  "name": "universal-ai-agent-suite",
  "version": "1.1.0",
  "description": "Full-stack AI Agent environment replication suite: 380+ canonical skills, 11 powerhouse plugins, 70+ subagents, Antigravity builtins, Autonomous Obsidian BrainVault protocol, Anti-Lag auto-delegation, and CL4R1T4S zero-hallucination obedience rules.",
  "target_paths": {
    "windows": {
      "gemini_dir": "~/.gemini",
      "gemini_config": "~/.gemini/config",
      "gemini_plugins": "~/.gemini/config/plugins",
      "gemini_builtin": "~/.gemini/antigravity-cli/builtin/skills",
      "gemini_rules": "~/.gemini/GEMINI.md",
      "agents_dir": "~/.agents",
      "agents_skills": "~/.agents/skills",
      "agents_rules": "~/.agents/AGENTS.md"
    },
    "unix": {
      "gemini_dir": "$HOME/.gemini",
      "gemini_config": "$HOME/.gemini/config",
      "gemini_plugins": "$HOME/.gemini/config/plugins",
      "gemini_builtin": "$HOME/.gemini/antigravity-cli/builtin/skills",
      "gemini_rules": "$HOME/.gemini/GEMINI.md",
      "agents_dir": "$HOME/.agents",
      "agents_skills": "$HOME/.agents/skills",
      "agents_rules": "$HOME/.agents/AGENTS.md"
    }
  },
  "components": {
    "rules": [
      "GEMINI.md",
      "AGENTS.md",
      "rules/CL4R1T4S_SCAFFOLDING.md"
    ],
    "configs": [
      "configs/config.json",
      "configs/import_manifest.json",
      "configs/mcp_config.json"
    ],
    "builtin_skills": [
      "agy-customizations",
      "antigravity_guide",
      "generative_ui",
      "migrate-workflows",
      "permissioned-github"
    ],
    "plugins": [
      "buddhist-method",
      "caveman",
      "cl4r1t4s-core",
      "context-management",
      "ecc",
      "humanizer",
      "i-have-adhd",
      "mattpocock-skills",
      "stop-slop",
      "superpowers",
      "ux-ui-agent-skills"
    ],
    "canonical_skills_count": 383,
    "subagents_count": 72
  },
  "sources": {
    "cl4r1t4s-core": {
      "origin": "Distilled High-Agency Scaffolding from Devin, Cursor, Manus, Claude Code",
      "references": [
        "https://cognition.ai",
        "https://cursor.com",
        "https://manus.im",
        "https://docs.anthropic.com"
      ]
    },
    "brainvault-architecture": {
      "name": "Autonomous Obsidian BrainVault Protocol",
      "origin": "Antigravity PKM & Memory Graph Specification",
      "vault_path": "C:\\Users\\Axioo\\BrainVault",
      "features": [
        "Map of Content",
        "Bidirectional Wikilinks",
        "Pre-Task Retrieval",
        "Post-Task Auto-Sync",
        "Zero-Polling Anti-Lag",
        "Deletion Safety Gate"
